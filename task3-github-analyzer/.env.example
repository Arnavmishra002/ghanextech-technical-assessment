# Free key from https://console.groq.com/keys (no card needed)
GROQ_API_KEY=

# Optional. Any OpenAI-compatible endpoint works (Groq, Gemini, OpenRouter, Ollama).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# Optional. Raises the GitHub API limit from 60 to 5,000 requests per hour.
# A fine-grained token with "Public repositories (read-only)" access is enough.
# GITHUB_TOKEN=
